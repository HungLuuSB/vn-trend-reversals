# Copy to .env on the laptop and fill in. Never commit .env.

# PostgreSQL (Airflow metadata later; operational metadata)
POSTGRES_USER=vnbank
POSTGRES_PASSWORD=
POSTGRES_DB=vnbank
POSTGRES_PORT=5432

# ClickHouse
CLICKHOUSE_USER=vnbank
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=vnbank
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# SeaweedFS S3 gateway (raw layer; replaces MinIO, see docs/adr/0001-object-store-seaweedfs.md)
S3_ACCESS_KEY=vnbank
S3_SECRET_KEY=
S3_PORT=8333
SEAWEED_MASTER_PORT=9333
S3_ENDPOINT=http://localhost:8333
S3_RAW_BUCKET=raw

# External APIs
FRED_API_KEY=

# vnstock generation 6. Prefer `uv run vnstock keys set <source>` (keyring). If this headless
# machine has no keyring, fill in ONLY the source you use here, then `chmod 600 .env`.
# vnstock reads .env from the current directory only: run commands from the repo root.
VNSTOCK_TELEMETRY=0
VNSTOCK_OAPI_SESSION_BACKEND=file
SSI_API_KEY=
SSI_API_SECRET=
DNSE_API_KEY=
DNSE_API_SECRET=
TCBS_API_KEY=
FHSC_API_KEY=
