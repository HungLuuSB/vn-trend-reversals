# --- Secrets (never commit) ---
.env
.env.*
!.env.example

# --- Data (never commit; raw lives in the S3 raw layer) ---
*.parquet
*.csv
*.tsv
*.feather
*.arrow
*.xlsx
*.xls
*.pdf
*.zip
*.gz
data/
raw/
research/paper*/runs/*/*
!research/paper*/runs/.gitkeep
# Paper 1's run records are public: small aggregate JSON only (no data, no logs)
!research/paper1/runs/*/config.json
!research/paper1/runs/*/metrics.json
!research/paper1/runs/*/summary.json

# --- Exception: curated reference seeds are code (sourced, hand-checked, small) ---
!dbt/seeds/*.csv

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
*.egg-info/
dist/
build/

# --- dbt ---
dbt/target/
dbt/dbt_packages/
dbt/logs/

# --- LaTeX build files (paper/generated/ is committed) ---
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.fdb_latexmk
paper/*.fls
paper/*.synctex.gz
paper/*.pdf

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store

# LaTeX build artefacts (papers are built with tectonic)
papers/**/*.log
papers/**/*.aux
papers/**/*.xdv
papers/**/*.bbl
papers/**/*.blg
papers/**/*.out

# Wiley LaTeX template (copyright Wiley; installed by scripts/setup-wiley-template.sh)
papers/paper1/USG.cls
papers/paper1/NJDapacite.sty
papers/paper1/lettersp.sty
papers/paper1/WileyNJD-APA.bst
papers/paper1/images/

# generated manuscript files
papers/**/*.docx
papers/**/*.pag
